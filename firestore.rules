rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 輔助函數 ──────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/profile/main)
          .data.role in ['ADMIN', 'OWNER'];
    }
    function isOwnerRole() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/profile/main)
          .data.role == 'OWNER';
    }

    // ── 遊戲資料（PLAN-029 Phase 3-2：讀取收緊為 isAdmin，寫入維持 isAdmin）──────
    // 原本 read: if true（任何人可直打 Firestore REST 白嫖／被爬）。改為 isAdmin() 後：
    //   · 匿名／一般登入使用者：client 直讀一律 permission-denied → 逼走 Cloudflare
    //     Worker（前台公開資料已全數改走 /api/data，見 Phase 2 + 3-1）；
    //   · Worker：用 service account（Admin SDK）呼叫 Firestore REST，本就繞過安全規則，
    //     照常讀得到 → 這正是本架構「真鎖直連、只留 Worker 一扇門」的關鍵；
    //   · 登入的管理員：後台編輯頁仍以 client SDK 直讀載入（getCollectionPage 等），
    //     isAdmin() 讓後台零改動即可運作。唯一代價是管理員本人能整包讀（非爬蟲風險）。
    // 取代了退場的 App Check（可被繞的票）→ 升級為規則層真鎖。回退：改回 if true 即時生效。
    match /pilots/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /mechs/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /modules/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /weapons/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /backpacks/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    // PLAN-043 背包技能庫：可共用、可等級化的背包技能定義庫
    match /backpackSkills/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /components/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /skills/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    // PLAN-004 技能庫抽離：可共用、可被引用的技能定義庫
    match /pilotSkills/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    // PLAN-023 神經驅動能力庫：可共用、可被引用的神驅能力定義庫
    match /neuralDriveAbilities/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    // PLAN-019-C 詞條庫：refType:'term' 機制關鍵字定義庫
    match /glossaryTerms/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    // PLAN-041 機師形態：調構師的形態實體，refType:'form' 的資料源
    match /forms/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /buffs/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /pilotResearch/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /globalResearch/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /enemies/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /patchVersions/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /grayOps/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    // 系統 meta（PLAN-017 遊戲資料版本號；Phase 3-2 收緊為 isAdmin 可讀，Worker 走 /api/versions 代讀，管理員可 bump）
    match /meta/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── PLAN-030 資料變更歷史：append-only 稽核 log ──────────────────────────
    // 本專案唯一「不」使用 allow write: if isAdmin() 的集合。
    // 理由：write 涵蓋 create/update/delete，沿用那套的話管理員就能竄改或抹除
    // 自己的操作記錄，稽核價值歸零。寫下去就定型，連管理員也改不了。
    //
    // 讀取限管理員：這是內部維運記錄，且刪除快照內含完整文件內容，不該公開。
    //
    // 保留期限交由 Firestore 原生 TTL 政策（expireAt 欄位，兩年）處理 ——
    // TTL 是後端程序，不受安全規則約束，因此與下方的 delete: if false 並不衝突。
    // 這正是理想組合：前端永遠刪不掉，但系統會自己過期清理。
    // create 額外綁定 actorUid == 本人 uid：只驗身分不驗內容的話，管理員可用
    // client SDK 直接寫入 actorUid 冒名的偽造記錄嫁禍他人，且因下方 append-only
    // 連本人也刪不掉、永久化（PLAN-030 Phase C 破壞性測試發現③）。append-only 防的
    // 是「竄改既有記錄」，這條防的是「偽造新記錄」，同屬稽核完整性。
    // 與程式相容：buildEntry 走管理員路徑時 actorUid 恆為 auth.currentUser.uid。
    match /changeHistory/{docId} {
      allow read:   if isAdmin();
      allow create: if isAdmin() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── 台版公告 staging（PLAN-048 Phase 2）──────────────────────────────────
    // 兩個集合**前台完全不讀**，一律 isAdmin()：
    //   announcementDrafts  官方公告原文草稿（爬蟲寫、後台審核時讀）
    //   pendingActivities   解析出的待審活動，審核最小單位是「一個活動」
    //
    // 與上方遊戲資料集合的差別在**不走 Worker 代理、也不進 CollectionKey**：
    // 它們是持續成長、只查最近幾頁的 staging 資料，塞進「整包載入 + localStorage」
    // 的版本快取只會撐爆快取（同 changeHistory 的理由）。
    //
    // 寫入者有二：爬蟲以 service account（Admin SDK）繞過規則；管理員在
    // /admin/announcements 審核時以 client SDK 更新 status / reviewed / mergedInto。
    // 因此**不能**照 analytics 那樣 write: if false。
    //
    // 保留期限：expireAt = 抓取時間 +6 個月，交由 Firestore 原生 TTL 政策清除
    // （比照 changeHistory.expireAt）。rawText 實測最大一篇 15.9 KB，
    // 一年約 1500 篇 ≈ 5 MB —— 不設 TTL 不會爆，但 staging 留著沒有意義，
    // 已合併的活動其事實已進 patchVersions，原文在本地歸檔另有一份。
    match /announcementDrafts/{docId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }
    match /pendingActivities/{docId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    // ── 系統診斷日誌（PLAN-045）──────────────────────────────────────────────
    // 維護者非預期登出與寫入被拒的證據記錄。結構比照上方 changeHistory（append-only
    // ＋ create 綁定本人 uid 防偽造嫁禍），差別在**讀取收緊為 isOwnerRole()**：
    // 記錄內含 UA、儲存用量、螢幕尺寸等裝置指紋，屬維護者個人的環境資訊，
    // 不該讓其他 ADMIN 互看。
    //
    // create 維持 isAdmin() 而非 isAuthenticated()：本計畫只追蹤維護者，
    // 放寬到一般登入使用者只會擴大寫入面並帶來限流需求（PLAN-045 決策四）。
    //
    // ⚠ 登出當下寫不進來是**預期行為**，不是規則沒設好——此時 request.auth 已為 null。
    //   那條路徑刻意改走 localStorage 佇列、等下次登入再補送（決策一）。
    match /systemLog/{docId} {
      allow read:   if isOwnerRole();
      allow create: if isAdmin() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── 使用統計（PLAN-046）──────────────────────────────────────────────────
    // 匿名彙總計數，只增不減。與本專案其他集合最大的不同是 **write: if false**：
    // 唯一的寫入者是 Cloudflare Worker，它以 service account 繞過安全規則
    // （同 PLAN-029 的代讀架構）。因此這裡對**所有** client 一律禁寫，包含管理員——
    //
    //   · 訪客也要統計 ⇒ 不能要求登入 ⇒ 若改成 client 直寫就得開 create: if true，
    //     那等於讓任何人用迴圈寫爆共用的每日寫入額度、並任意灌水數字；
    //   · 走 Worker 則另有格式防護、數量上限、寫入預算熔斷器三層把關（見 workers/src/collect.ts）。
    //
    // 讀取用 isAdmin() 而非 isOwnerRole()：內容是站務彙總數字，**不含任何可識別個人
    // 的行為資料**（PLAN-046 Q4 裁決不記錄個別使用者），敏感度低於 systemLog 那種
    // 帶裝置指紋的記錄，沒必要收到只有 OWNER 看得到。
    //
    // 保留期限：日文件約 3 KB、月文件約 60 KB，一年合計不到 2 MB，
    // 故**刻意不設 TTL** —— 與 changeHistory / systemLog（存整份文件快照）不同。
    match /analyticsDaily/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }
    match /analyticsEntity/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ── 用戶資料（本人可讀寫）────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /profile/{docId} {
        allow read: if isOwner(userId) || isAdmin() || resource.data.role in ['ADMIN', 'OWNER'];
        // 建立時只允許 role='USER'，禁止自行設為 ADMIN/OWNER
        allow create: if isOwner(userId) &&
          request.resource.data.role == 'USER';
        // 本人可更新自己 profile，但不能修改 role（防止提權）
        // OWNER 可更新任何人的 profile（包含修改 role）
        allow update: if
          (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) ||
          isOwnerRole();
      }
      match /builds/{buildId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── collectionGroup 查詢（getAllUsers 使用 collectionGroup('profile')）──
    match /{path=**}/profile/{docId} {
      allow read: if isAdmin() || resource.data.role in ['ADMIN', 'OWNER'];
    }
  }
}
