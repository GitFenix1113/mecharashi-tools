# Vite 模式檔：僅在 `vite --mode emulator`（= npm run dev:emu）時載入。
# 一般 `npm run dev` 與所有 production build 都不會讀到這個檔案。
#
# 刻意不放進 .env.local —— 那個檔在所有模式都會載入，很容易忘了關，
# 造成「以為在測試、其實打正式資料庫」或反過來。模式檔讓切換保持顯式。
#
# Firebase 專案設定（VITE_FIREBASE_*）仍由 .env.local 提供：
# .env.local 在所有模式都會載入，所以這裡只需要覆寫旗標。
#
# 本檔不含任何機密，可以進版控。

VITE_USE_EMULATOR=true

# PLAN-029 的 Worker 代理必須在模擬器模式關掉，否則整個測試環境是假的。
#
# WORKER_ENABLED 只看 VITE_WORKER_API_BASE 有沒有值，而那個變數住在 .env.local
# ——它在**所有模式**都會載入。結果是：VITE_USE_EMULATOR=true 只把 Firebase SDK
# 指向模擬器，公開集合卻仍走 /api/data/* 打到正式站（本機還會因 CORS 全部失敗，
# 畫面空白、console 洗版數千則）。這正是 PLAN-029 上線後沒人再回頭檢查的死角。
#
# VITE_USE_WORKER=false 是既有的 kill-switch，讓資料層退回 Firestore SDK 直連，
# 而 SDK 已被 VITE_USE_EMULATOR 指向本機模擬器 —— 兩個旗標合起來才是完整的隔離。
VITE_USE_WORKER=false

# ── 自動登入的 seed 管理員帳號（選填）─────────────────────────────────────────
# 模擬器的遊戲資料同樣是 `read: if isAdmin()`，不登入就是 0 筆且不報錯，所以
# AuthContext 在此模式下會自動登入 emu:seed 建立的 OWNER 帳號，免去每次重整手動登入。
#
# 下面兩行平常**不需要**設定 —— AuthContext 的預設值已對齊 scripts/seed-emulator.mjs
# 的 DEFAULTS。只有當你用 `npm run emu:seed -- --email X --password Y` 自訂帳號時，
# 才需要取消註解並填上同一組值。
# VITE_EMU_ADMIN_EMAIL=dev-admin@local.test
# VITE_EMU_ADMIN_PASSWORD=devadmin
