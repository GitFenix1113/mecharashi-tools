{
  "_說明": [
    "PLAN-064 決策五：戰場觸發器 → 增援時程／事件的中文模板。scripts/lib/raidRender.mjs 讀這份。",
    "events：觸發器的事件型別（BattlePipeEventType）。timing＝回合型事件（start／end）；start＝開戰時；text＝事件本身就是觸發時點。",
    "conditions：條件型別（BattleTriggerConditionType）。role 決定怎麼用：",
    "  turn＝回合條件（Round，p1＝第幾回合）；turnAfter＝第 p1 回合之後（RoundGreat）；",
    "  moment＝觸發時點（例：某單位被擊破時），會當成 when 的文字；also＝附帶條件（「若…」）；",
    "  blackboard＝黑板變數，靠同一戰場其他觸發器反推語意；orBegin／orEnd＝「或」群組括號；neutral＝內部機制，不顯示也不算未知。",
    "  text／notText：條件成立／條件加了 m_not 時的文字。對不到的型別一律當「未知」，前台顯示「特定條件觸發」，報告列 ⬜。",
    "佔位：{s}／{s2}＝戰場單位參照（轉成 ⟦unit:…⟧）；{p1}…{p4}＝數值；{part:p1}＝部位名；{pct:p2}＝萬分比轉百分比；",
    "  {buf:p1}＝⟦buf:…⟧；{active:p1}＝⟦active:…⟧；{terrain:p3}＝⟦terrain:…⟧；{team:p1}＝隊伍名。",
    "部位與萬分比是推定：ActorBodyPartHpGreat 的 p1 依 WapPartType（1 軀幹、2 左臂、3 右臂、4 腿部、5 整機），p2 依設定表慣例以萬分比解讀（7500＝75%）。"
  ],
  "events": {
    "FormationSetupStart": { "start": true },
    "BattleStart": { "start": true },
    "BattleTurnStart": { "timing": "start" },
    "BattleTurnEnd": { "timing": "end" },
    "TeamActive": { "timing": "start" },
    "TeamEnd": { "timing": "end" },
    "ActorDie": { "text": "有機體被擊破時" },
    "OperationEnd": { "text": "" },
    "ActorActionEnd": { "text": "" },
    "ActorActionStart": { "text": "" },
    "ActorCastSkillEnd": { "text": "" },
    "ActorOnHit": { "text": "" },
    "ActorWapPartDestroy": { "text": "有部位被破壞時" },
    "ActorAdd": { "text": "" },
    "BlackBoardValueChange": { "text": "" }
  },
  "conditions": {
    "Round": { "role": "turn" },
    "RoundGreat": { "role": "turnAfter" },
    "TeamRound": { "role": "neutral" },
    "GroupBegin": { "role": "orBegin" },
    "GroupEnd": { "role": "orEnd" },
    "BlackBoardKeyValueEqual": { "role": "blackboard" },
    "SceneObjectState": { "role": "neutral" },
    "CurrDeadActorIsOneOf": { "role": "moment", "text": "{s}被擊破時" },
    "CurrDeadActorTeamType": { "role": "moment", "text": "{team:p1}有機體被擊破時" },
    "ActorBodyPartHpGreat": { "role": "moment", "text": "{s}的{part:p1}耐久高於 {pct:p2}", "notText": "{s}的{part:p1}耐久降到 {pct:p2} 以下時" },
    "SkillCast": { "role": "moment", "text": "{s}使用{active:p1}後" },
    "ActorBeAttackedBySkill": { "role": "moment", "text": "{s}受到技能攻擊時" },
    "GridTerrainEffectFireSuccess": { "role": "moment", "text": "{terrain:p3}觸發時" },
    "ActorLive": { "role": "also", "text": "{s}仍存活", "notText": "{s}已被擊破" },
    "ActorAlreadyDead": { "role": "also", "text": "{s}已被擊破", "notText": "{s}仍存活" },
    "ActorLiveGreat": { "role": "also", "text": "{s}存活數多於 {p1}", "notText": "{s}存活數不超過 {p1}" },
    "ActorHasBuf": { "role": "also", "text": "{s}帶有{buf:p1}", "notText": "{s}沒有{buf:p1}" },
    "ActorBufLevelCompare": { "role": "also", "text": "{s}的{buf:p1}達 {p2} 層" },
    "ActorExistWapPartDestroyed": { "role": "also", "text": "{s}有部位被破壞", "notText": "{s}沒有部位被破壞" },
    "CurrActor": { "role": "also", "text": "行動者為{s}" },
    "CurrActorIsOneOf": { "role": "also", "text": "行動者為{s}" },
    "CurrTarget": { "role": "also", "text": "目標為{s}" },
    "CurrTargetIsOnOf": { "role": "also", "text": "目標為{s}" },
    "ActorInRegion": { "role": "also", "text": "{s}進入指定區域", "notText": "{s}不在指定區域" },
    "OneOfActorInRegion": { "role": "also", "text": "有機體進入指定區域", "notText": "指定區域內沒有機體" },
    "ActorApEqual": { "role": "also", "text": "{s}的 AP 為 {p1}" },
    "ActorApGreat": { "role": "also", "text": "{s}的 AP 多於 {p1}", "notText": "{s}的 AP 不超過 {p1}" }
  },
  "parts": { "1": "軀幹", "2": "左臂", "3": "右臂", "4": "腿部", "5": "整機" },
  "teams": { "1": "我方", "2": "我方", "3": "敵方", "4": "敵方", "5": "第三方", "6": "第三方", "7": "環境" }
}
