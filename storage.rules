// ⚠ 這份規則目前**尚未部署，也部署不了**：本專案的 Firebase Storage 從未啟用
//   （`firebase deploy --only storage` 回 "Firebase Storage has not been set up
//   on project 'mecharashi-tools'"）。因此下方規則現在一條都沒有實際效力。
//
//   站上所有使用者上傳的圖片走的是 **Cloudinary**（src/lib/imageUpload.ts，
//   unsigned upload preset），不經過這裡。真正該把關的限制在 Cloudinary 的
//   preset 設定（允許格式、檔案大小、資料夾鎖定），不在這個檔案。
//
//   保留這份檔案的用意是：哪天真的啟用 Storage，它會**立刻生效**——所以裡面不能
//   留有「反正沒部署」心態寫下的寬鬆規則（banners 那條就是，已於 2026-08-23 收掉）。
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── 頭像（公開讀，本人限寫）────────────────────────────────────────────────
    match /avatars/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ── 版本前瞻圖（公開讀，寫入已關閉）────────────────────────────────────────
    // 原規則是 `write: if request.auth != null` ＋ 大小／型別限制，註解寫「管理員身分
    // 由應用層驗證」—— 但應用層擋不住直接呼叫 Storage SDK 的人，**規則層才是唯一防線**。
    // 照那樣寫，只要辦一個 Google 帳號登入本站，就能往這裡無限寫 10MB 檔案
    // （{allPaths=**} 檔名任取、沒有數量上限）；Blaze 方案下那是帳單，不是資料風險。
    //
    // 改成 if false 不影響任何現有功能——前端**沒有任何 Storage 上傳程式碼**
    // （src/ 全域只有 firebase.ts 的 getStorage(app) 初始化）：
    //   · 頭像走 Cloudinary（src/lib/imageUpload.ts）
    //   · 版本橫幅是本地 /images/banners/*.webp（src/data/patchVersions/）
    //
    // ⚠ 未來若要恢復後台上傳：**不要**改回 `request.auth != null`。比照上方 avatars
    //   把身分綁進路徑（uid 或固定檔名白名單），或由 Worker 以 service account 代寫。
    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

  }
}
