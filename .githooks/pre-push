#!/bin/sh
# .githooks/pre-push
# 在每次 push 前：(1) build 把關 → (2) 更新 CHANGELOG.md（該筆 commit 由下次 push 帶走）。

# ── (1) Build 把關（CLAUDE.md 規則 3：push 前 build 必須成功）──────────────
echo "🔨  執行 pre-push：npm run build（tsc -b + vite build）..."
npm run build
if [ $? -ne 0 ]; then
  echo "❌  build 失敗，已中止 push。請修正 TypeScript / 打包錯誤後再推。"
  echo "    （build 太慢想暫時略過：git push --no-verify，但不建議）"
  exit 1
fi
echo "✅  build 通過"

# ── (2) 更新 CHANGELOG.md ─────────────────────────────────────────────────
echo "🔄  執行 pre-push：更新 CHANGELOG.md ..."

# 收集即將推送的 commit 摘要（排除 changelog 更新本身，最多 10 筆）
PUSHED_COMMITS=$(git log origin/main..HEAD --pretty=format:"%s" --no-merges 2>/dev/null \
  | grep -v "^chore.*CHANGELOG" \
  | head -10)

# 更新 changelog
node scripts/update-changelog.js
if [ $? -ne 0 ]; then
  echo "❌  update-changelog.js 執行失敗，中止 push。"
  exit 1
fi

# 若 CHANGELOG.md 有變動，自動 commit
if [ -n "$(git status --porcelain CHANGELOG.md)" ]; then
  git add CHANGELOG.md

  if [ -n "$PUSHED_COMMITS" ]; then
    FIRST_COMMIT=$(echo "$PUSHED_COMMITS" | head -1)
    COMMIT_LIST=$(echo "$PUSHED_COMMITS" | sed 's/^/- /')
    git commit -m "chore: 自動更新 CHANGELOG.md — $FIRST_COMMIT" -m "包含：
$COMMIT_LIST"
  else
    git commit -m "chore: 自動更新 CHANGELOG.md"
  fi

  # ⚠ 這筆 commit **推不進本次 push**，別再嘗試在這裡補推（試過了，見下）。
  #
  # git 在呼叫本 hook 之前就已鎖定 refspec 的 compare-and-swap 期望值
  # （「main 從 <舊 sha> 更新到 <新 sha>」）。hook 內若自己 git push 一次，
  # remote 就前進到期望值以外，外層 push 隨即被 remote 拒絕：
  #     ! [remote rejected] main -> main (cannot lock ref 'refs/heads/main':
  #       is at 94e3dc0 but expected 15f06ce)
  #     error: failed to push some refs
  # 東西其實有上去，但 git push 以 exit 1 收場 —— 拿「延一次」換「每次報錯」，
  # 是明顯的退步。hook 這層做不到，正解是讓 commit 在 push 開始**之前**就存在。
  #
  # 想一次推完：用 npm run push（它先產生 CHANGELOG commit 再 git push）。
  echo "📝  CHANGELOG.md 已自動 commit（本次推不到，下次 push 會帶走；想一次推完用 npm run push）"
fi

exit 0
