#!/bin/sh
# .githooks/pre-push
# 在每次 push 前：(1) build 把關 → (2) 更新 CHANGELOG.md，並補推該筆 commit。

REMOTE="$1"

# pre-push 的 stdin 每行是「<local ref> <local sha> <remote ref> <remote sha>」，
# 且**只讀得到一次**，所以在最前面整包吃下來，留給 (2) 判斷要補推到哪條 remote ref。
PUSH_PLAN=$(cat)

# 記下「還沒產生 CHANGELOG commit 前」的 HEAD —— 用來確認本次推的就是當前分支。
HEAD_BEFORE=$(git rev-parse HEAD)

# ── (1) Build 把關（CLAUDE.md 規則 3：push 前 build 必須成功）──────────────
echo "🔨  執行 pre-push：npm run build（tsc -b + vite build）..."
npm run build
if [ $? -ne 0 ]; then
  echo "❌  build 失敗，已中止 push。請修正 TypeScript / 打包錯誤後再推。"
  echo "    （build 太慢想暫時略過：git push --no-verify，但不建議）"
  exit 1
fi
echo "✅  build 通過"

# ── (2) 更新 CHANGELOG.md ─────────────────────────────────────────────────
echo "🔄  執行 pre-push：更新 CHANGELOG.md ..."

# 收集即將推送的 commit 摘要（排除 changelog 更新本身，最多 10 筆）
PUSHED_COMMITS=$(git log origin/main..HEAD --pretty=format:"%s" --no-merges 2>/dev/null \
  | grep -v "^chore.*CHANGELOG" \
  | head -10)

# 更新 changelog
node scripts/update-changelog.js
if [ $? -ne 0 ]; then
  echo "❌  update-changelog.js 執行失敗，中止 push。"
  exit 1
fi

# 若 CHANGELOG.md 有變動，自動 commit
if [ -n "$(git status --porcelain CHANGELOG.md)" ]; then
  git add CHANGELOG.md

  if [ -n "$PUSHED_COMMITS" ]; then
    FIRST_COMMIT=$(echo "$PUSHED_COMMITS" | head -1)
    COMMIT_LIST=$(echo "$PUSHED_COMMITS" | sed 's/^/- /')
    git commit -m "chore: 自動更新 CHANGELOG.md — $FIRST_COMMIT" -m "包含：
$COMMIT_LIST"
  else
    git commit -m "chore: 自動更新 CHANGELOG.md"
  fi

  # 這筆 commit 是在 git 算完「本次要推哪些 sha」之後才產生的，因此**不在**本次
  # push 的範圍內 —— 舊版註解寫「將一併推送」其實做不到，它只會留在本機等下一次
  # push 順便帶走（實際症狀：push 完 git status 顯示 ahead 1）。所以這裡主動補推。
  #
  # --no-verify 是必要的：否則補推會再次觸發本 hook，白跑一次完整 build。
  PUSH_REF=$(echo "$PUSH_PLAN" | awk -v head="$HEAD_BEFORE" '$2 == head { print $3; exit }')

  if [ -n "$REMOTE" ] && [ -n "$PUSH_REF" ]; then
    echo "📤  補推 CHANGELOG.md commit → $PUSH_REF"
    if git push --no-verify "$REMOTE" "HEAD:$PUSH_REF"; then
      echo "✅  已補推（接著 git 本體會顯示 Everything up-to-date，屬正常）"
    else
      # 補推失敗不該連累本次 push：commit 已在本機，下次 push 仍會帶走。
      echo "⚠   補推失敗 —— 本次 push 不受影響，CHANGELOG commit 留在本機等下次帶走。"
    fi
  else
    # 推的不是當前分支（例如 git push origin other:main），HEAD 上的 commit 與本次
    # 推送對不上，不猜目標、交回下次處理。
    echo "📝  CHANGELOG.md 已自動 commit（本次未補推，下次 push 會帶走）。"
  fi
fi

exit 0
