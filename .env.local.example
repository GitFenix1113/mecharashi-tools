# Firebase 設定 — 從 Firebase Console > Project Settings > Your apps 取得
# 複製此檔案為 .env.local 並填入你的金鑰

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# 註：App Check / reCAPTCHA 已於 PLAN-029 Phase 3-3 退場（改用 CF Worker 代理 +
# Firestore read:if isAdmin 真鎖），不再需要 VITE_FIREBASE_APPCHECK_SITE_KEY /
# VITE_APPCHECK_DEBUG_TOKEN。

# ── PLAN-029 Phase 2：Cloudflare Worker 資料代理 ──
# 設定後，前端公開遊戲資料改打 Worker /api（不再直連 Firestore）。留空 → 沿用直連。
#   · 本機測試 Worker：跑 `cd workers && npx wrangler dev`，填 http://localhost:8787
#   · 生產：填已部署的 Worker 網址（例如 https://mecharashi-worker.<account>.workers.dev 或自訂路由）
VITE_WORKER_API_BASE=
# kill-switch：不動 VITE_WORKER_API_BASE 的情況下強制回退直連，填 false 即可
VITE_USE_WORKER=
