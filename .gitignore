public/debug/

# 文件頁靜態文件（由 scripts/copy-docs.mjs 從 docs/ 複製產生）
public/docs/

# Temp scripts
scripts/temp_scripts/

# 本地開發參考筆記（不提交，僅本機參考）
_local-notes/

# 防線 C — 資料管線私有化（保留本機可用，不進公開 repo；墊高「複製貼上就營利」的成本）
scripts/scrape-*.js
scripts/seed-*.mjs
scripts/migrate-plan004-*.mjs
scripts/init-patch-versions.mjs
# 例外：模擬器種子不是資料管線，是測試基礎建設，必須進版控才能重現 Phase 0 環境。
# 它只在 localhost 生效（腳本內有硬性防呆），且揭露的「role 存在 Firestore 文件」
# 在已提交的 firestore.rules 裡本來就看得到，不構成防線 C 要防的資訊洩漏。
!scripts/seed-emulator.mjs
scripts/patch-component-outerframe.mjs
scripts/bump-data-version.mjs
# PLAN-034 H-2：唯讀漂移檢查，但內含官方 API endpoint 與 appkey，與 scraper 同級敏感。
# 換機器／重新 clone 時需重建（同 bump-data-version.mjs 的既有取捨）。
scripts/check-nd-minsum-drift.mjs
.claude/skills/data-patch/

# PLAN-038 follow-up：社群卡片用的 JPEG 立繪，由 scripts/generate-og-entity-images.mjs
# 於 build/dev 前置產生（約 4MB / 177 張）。可完全重現，不進版控。
public/images/og/entities/
